// =====================================================
// SETUP
// =====================================================

void setup()
{
#if DEBUG_DISTANCIA
    Serial.begin(115200);
#endif

    // ---------- Entradas ----------
    pinMode(SENSOR2, INPUT_PULLUP);
    pinMode(SENSOR3, INPUT_PULLUP);
    pinMode(INICIO, INPUT_PULLUP);
    pinMode(STOP, INPUT_PULLUP);
    pinMode(ULTRA_ECHO, INPUT);       // con divisor de tensión externo

    // ---------- Salidas en estado seguro ----------
    pinMode(BANDA_STEP, OUTPUT);
    pinMode(BANDA_DIR, OUTPUT);
    pinMode(ULTRA_TRIG, OUTPUT);
    digitalWrite(ULTRA_TRIG, LOW);
    digitalWrite(BANDA_STEP, LOW);
    digitalWrite(BANDA_DIR, SENTIDO_BANDA);
    bandaGirando = false;

    // ---------- Servomotores en posición inicial ----------
    ESP32PWM::allocateTimer(0);
    ESP32PWM::allocateTimer(1);
    ESP32PWM::allocateTimer(2);
    ESP32PWM::allocateTimer(3);

    for (int i = 0; i < NUM_SERVOS; i++)
    {
        servos[i].setPeriodHertz(50);
        servos[i].attach(PIN_SERVO[i], PULSO_MIN, PULSO_MAX);
        servos[i].write(ANGULO_INICIAL[i]);
    }

    // ---------- Temporizador de pasos del motor ----------
    esp_timer_create_args_t argsTimer = {};
    argsTimer.callback = generarPaso;
    argsTimer.arg = NULL;
    argsTimer.dispatch_method = ESP_TIMER_TASK;
    argsTimer.name = "pasos_banda";

    esp_timer_create(&argsTimer, &timerPasos);
    esp_timer_start_once(timerPasos, 1000);   // no emite pulsos hasta START

    // ---------- Cola sensores/Bluetooth -> garra ----------
    colaGarra = xQueueCreate(2, sizeof(EventoGarra));

    // ---------- Tareas originales ----------
    // Orden: primero las que otras tareas notifican.
    xTaskCreatePinnedToCore(tareaBandaFn,    "banda",    2048, NULL, PRIO_BANDA,    &tareaBanda,    NUCLEO_APP);
    xTaskCreatePinnedToCore(tareaGarraFn,    "garra",    4096, NULL, PRIO_GARRA,    &tareaGarra,    NUCLEO_APP);
    xTaskCreatePinnedToCore(tareaControlFn,  "control",  3072, NULL, PRIO_CONTROL,  &tareaControl,  NUCLEO_APP);
    xTaskCreatePinnedToCore(tareaSensoresFn, "sensores", 3072, NULL, PRIO_SENSORES, &tareaSensores, NUCLEO_APP);

    // ---------- Bluetooth (solo si USAR_BLUETOOTH = 1) ----------
    // Si Bluetooth no inicia, la clasificadora sigue funcionando sin él.
#if USAR_BLUETOOTH
    if (SerialBT.begin(NOMBRE_BLUETOOTH))
    {
        xTaskCreatePinnedToCore(tareaBluetoothFn, "bluetooth", 4096, NULL,
                                PRIO_BLUETOOTH, &tareaBluetooth, NUCLEO_APP);
    }
#endif

    // ---------- Interrupciones (al final, con las tareas ya creadas) ----------
    attachInterrupt(digitalPinToInterrupt(INICIO), interrupcionInicio, FALLING);
    attachInterrupt(digitalPinToInterrupt(STOP),   interrupcionStop,   FALLING);
    attachInterrupt(digitalPinToInterrupt(ULTRA_ECHO), interrupcionEcho, CHANGE);
}

void loop()
{
    // Todo el funcionamiento está en las tareas de FreeRTOS.
    // Se elimina la tarea de Arduino para no consumir CPU.
    vTaskDelete(NULL);
}
