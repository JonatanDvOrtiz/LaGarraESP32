// =============================
// GENERADOR DE PASOS DEL MOTOR
// =============================

// Se ejecuta en el timer de esp_timer (núcleo 0). Alterna STEP en alto/bajo
// (50 % de ciclo) sin esperas de busy-wait, y re-arma el siguiente disparo.
// Solo emite pulsos si bandaGirando es true.
static uint32_t velocidadActual = VELOCIDAD_INICIAL_PASOS_S;
static uint32_t semiperiodoUs   = 1000;
static volatile bool pasoAlto   = false;

void generarPaso(void *arg)
{
    uint32_t espera;

    if (pasoAlto)
    {
        gpio_set_level((gpio_num_t)BANDA_STEP, 0);
        pasoAlto = false;
        espera = semiperiodoUs;
    }
    else if (bandaGirando)
    {
        if (velocidadActual < VELOCIDAD_PASOS_S)
        {
            velocidadActual += ACELERACION_PASOS_S2 / velocidadActual;
            if (velocidadActual > VELOCIDAD_PASOS_S)
            {
                velocidadActual = VELOCIDAD_PASOS_S;
            }
        }

        semiperiodoUs = 500000UL / velocidadActual;
        gpio_set_level((gpio_num_t)BANDA_STEP, 1);
        pasoAlto = true;
        espera = semiperiodoUs;
    }
    else
    {
        // Detenida: el próximo arranque empieza desde la velocidad inicial
        velocidadActual = (VELOCIDAD_INICIAL_PASOS_S < VELOCIDAD_PASOS_S)
                          ? VELOCIDAD_INICIAL_PASOS_S
                          : VELOCIDAD_PASOS_S;
        espera = 1000;
    }

    esp_timer_start_once(timerPasos, espera);
}


// ========================================================
// FUNCIONES DE LA GARRA (solo las usa tareaGarra y setup)
// ========================================================

void garraActivar(int sensor)
{
    if (sensor < 1 || sensor > NUM_SENSORES)
    {
        return;
    }

    for (int i = 0; i < NUM_SERVOS; i++)
    {
        servos[i].write(ANGULO_FINAL[sensor - 1][i]);
    }
}

void garraDesactivar()
{
    for (int i = 0; i < NUM_SERVOS; i++)
    {
        servos[i].write(ANGULO_INICIAL[i]);
    }
}


// =================================
// FUNCIONES DEL SENSOR ULTRASÓNICO
// =================================

// Envía el pulso TRIG. Solo quedan esperas de 2 y 10 microsegundos,
// exigidas por el HC-SR04. No espera el eco.
void dispararUltrasonico()
{
    portENTER_CRITICAL(&mux);
    echoListo = false;
    echoInicioUs = 0;
    portEXIT_CRITICAL(&mux);

    digitalWrite(ULTRA_TRIG, LOW);
    delayMicroseconds(2);
    digitalWrite(ULTRA_TRIG, HIGH);
    delayMicroseconds(10);
    digitalWrite(ULTRA_TRIG, LOW);
}

// Última distancia en cm, o -1 si no hubo eco completo
float leerDistanciaCm()
{
    bool listo;
    uint32_t duracion;

    portENTER_CRITICAL(&mux);
    listo = echoListo;
    duracion = echoDuracionUs;
    portEXIT_CRITICAL(&mux);

    if (!listo)
    {
        return -1.0;
    }

    return duracion / 58.0;
}


// ===============
// INTERRUPCIONES
// ===============

// START: solo avisa a la tarea de control (el antirrebote se hace allí)
void IRAM_ATTR interrupcionInicio()
{
    BaseType_t despertar = pdFALSE;

    if (tareaControl != NULL)
    {
        xTaskNotifyFromISR(tareaControl, NOTIF_START, eSetBits, &despertar);
    }

    if (despertar == pdTRUE)
    {
        portYIELD_FROM_ISR();
    }
}

// STOP: la parada del motor ocurre AQUÍ, sin esperar a ninguna tarea.
// Después despierta a la tarea de control (prioridad máxima).
void IRAM_ATTR interrupcionStop()
{
    BaseType_t despertar = pdFALSE;

    portENTER_CRITICAL_ISR(&mux);
    emergenciaActiva = true;
    sistemaActivo    = false;
    bandaGirando     = false;
    generacionParada++;
    portEXIT_CRITICAL_ISR(&mux);

    gpio_set_level((gpio_num_t)BANDA_STEP, 0);

    if (tareaControl != NULL)
    {
        xTaskNotifyFromISR(tareaControl, NOTIF_STOP, eSetBits, &despertar);
    }

    if (despertar == pdTRUE)
    {
        portYIELD_FROM_ISR();
    }
}

// ECHO del ultrasónico (flanco de subida y de bajada)
void IRAM_ATTR interrupcionEcho()
{
    uint32_t ahora = (uint32_t)esp_timer_get_time();

    portENTER_CRITICAL_ISR(&mux);

    if (gpio_get_level((gpio_num_t)ULTRA_ECHO) == HIGH)
    {
        echoInicioUs = ahora;
    }
    else if (echoInicioUs != 0)
    {
        echoDuracionUs = ahora - echoInicioUs;
        echoListo = true;
        echoInicioUs = 0;
    }

    portEXIT_CRITICAL_ISR(&mux);
}


// ================================================
// TAREA CONTROL (STOP / START) - PRIORIDAD MÁXIMA
// ================================================

void tareaControlFn(void *parametro)
{
    TickType_t ultimoInicio = 0;
    bool hayInicioPrevio = false;

    for (;;)
    {
        uint32_t bits = 0;

        // Espera por notificación (con tiempo límite, nunca infinita)
        if (xTaskNotifyWait(0, TODOS_LOS_BITS, &bits, pdMS_TO_TICKS(100)) != pdTRUE)
        {
            continue;
        }

        // ---------------- STOP ----------------
        if (bits & NOTIF_STOP)
        {
            // La ISR ya apagó el motor. Aquí se refuerza y se avisa al resto.
            portENTER_CRITICAL(&mux);
            bandaGirando = false;
            manualBandaSolicitada = false;   // Una emergencia anula la orden manual de banda
            portEXIT_CRITICAL(&mux);
            gpio_set_level((gpio_num_t)BANDA_STEP, 0);

            // Interrumpe la espera de la garra. La garra NO se mueve:
            // los servos quedan en la posición en que estaban.
            xTaskNotify(tareaGarra, NOTIF_ABORTAR, eSetBits);
            xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
        }

        // ---------------- START ----------------
        if (bits & NOTIF_START)
        {
            TickType_t ahora = xTaskGetTickCount();
            bool rebote = hayInicioPrevio &&
                          ((ahora - ultimoInicio) < pdMS_TO_TICKS(ANTIREBOTE_INICIO_MS));

            // START solo se acepta si sigue presionado y STOP está liberado
            if (!rebote &&
                digitalRead(INICIO) == LOW &&
                digitalRead(STOP) == HIGH)
            {
                bool veniaDeEmergencia;

                portENTER_CRITICAL(&mux);
                veniaDeEmergencia = emergenciaActiva;
                emergenciaActiva = false;
                sistemaActivo    = true;
                manualBandaSolicitada = false;   // En MANUAL la banda exige un BANDA;ON nuevo
                portEXIT_CRITICAL(&mux);

                ultimoInicio = ahora;
                hayInicioPrevio = true;

                // Solo tras una emergencia se avisa a la garra de que
                // una persona reanudó el sistema.
                if (veniaDeEmergencia)
                {
                    xTaskNotify(tareaGarra, NOTIF_REANUDAR, eSetBits);
                }

                xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
            }
        }
    }
}


// ===============
// TAREA SENSORES
// ===============

struct SensorClasif
{
    uint8_t pin;
    uint8_t id;          // 2 o 3
    uint8_t cntActivo;   // lecturas consecutivas con objeto
    uint8_t cntLibre;    // lecturas consecutivas sin objeto
    bool    armado;      // true = puede generar un nuevo evento
};

void tareaSensoresFn(void *parametro)
{
    SensorClasif sens[2] = {
        { SENSOR2, 2, 0, 0, true },
        { SENSOR3, 3, 0, 0, true }
    };

    const TickType_t periodo = pdMS_TO_TICKS(TIEMPO_SENSORES);
    const TickType_t ventana = pdMS_TO_TICKS(VENTANA_HABILITACION_MS);
    const uint32_t ciclosUltra = TIEMPO_ULTRASONICO / TIEMPO_SENSORES;

    uint32_t ciclo = ciclosUltra;      // mide en el primer ciclo
    bool presenciaVista = false;
    TickType_t tickPresencia = 0;

    TickType_t referencia = xTaskGetTickCount();

    for (;;)
    {
        // Periodo exacto basado en ticks, sin deriva
        vTaskDelayUntil(&referencia, periodo);

        // ---------- Ultrasónico: valida presencia ----------
        if (++ciclo >= ciclosUltra)
        {
            ciclo = 0;

            float distancia = leerDistanciaCm();
            dispararUltrasonico();

            if (distancia > 0.0 && distancia <= DISTANCIA_DETECCION_CM)
            {
                presenciaVista = true;
                tickPresencia = xTaskGetTickCount();
            }

            // Publicar distancia y presencia para la telemetría
            portENTER_CRITICAL(&mux);
            tel.distanciaCm = distancia;                     // -1 si no hubo eco válido
            tel.presencia = (distancia > 0.0)
                            ? ((distancia <= DISTANCIA_DETECCION_CM) ? 1 : 0)
                            : -1;
            portEXIT_CRITICAL(&mux);

#if DEBUG_DISTANCIA
            Serial.print("Distancia: ");
            if (distancia > 0.0)
            {
                Serial.print(distancia, 1);
                Serial.println(" cm");
            }
            else
            {
                Serial.println("sin eco");
            }
#endif
        }

        // El ultrasónico habilita a los sensores 2 y 3 mientras la
        // presencia detectada esté dentro de la ventana de tiempo.
        bool habilitado = presenciaVista &&
                          ((TickType_t)(xTaskGetTickCount() - tickPresencia) <= ventana);

        // Publicar el estado lógico de los sensores aunque el sistema
        // esté detenido (1 = detectando, 0 = libre; el pin físico es activo en LOW).
        bool s2Detecta = (digitalRead(SENSOR2) == LOW);
        bool s3Detecta = (digitalRead(SENSOR3) == LOW);

        portENTER_CRITICAL(&mux);
        tel.s2 = s2Detecta;
        tel.s3 = s3Detecta;
        tel.habilitado = habilitado;
        portEXIT_CRITICAL(&mux);

        // ---------- ¿Sistema iniciado? ----------
        bool activo;
        portENTER_CRITICAL(&mux);
        activo = sistemaActivo && !emergenciaActiva;
        portEXIT_CRITICAL(&mux);

        if (!activo)
        {
            // Sistema detenido: se reinicia el antirrebote
            for (int i = 0; i < 2; i++)
            {
                sens[i].cntActivo = 0;
                sens[i].cntLibre  = 0;
                sens[i].armado    = true;
            }
            continue;
        }

        // ---------- Sensores de clasificación ----------
        for (int i = 0; i < 2; i++)
        {
            bool detecta = (digitalRead(sens[i].pin) == LOW);

            if (detecta)
            {
                sens[i].cntLibre = 0;
                if (sens[i].cntActivo < 255) sens[i].cntActivo++;
            }
            else
            {
                sens[i].cntActivo = 0;
                if (sens[i].cntLibre < 255) sens[i].cntLibre++;

                // Se rearma solo cuando el sensor quedó libre
                if (sens[i].cntLibre >= CONFIRMACIONES_SENSOR)
                {
                    sens[i].armado = true;
                }
            }

            if (sens[i].armado &&
                sens[i].cntActivo >= CONFIRMACIONES_SENSOR &&
                habilitado)
            {
                bool reservado = false;
                EventoGarra evento;

                // Reserva atómica de la garra: evita eventos duplicados.
                // En modo MANUAL los sensores no generan eventos automáticos.
                portENTER_CRITICAL(&mux);
                if (sistemaActivo && !emergenciaActiva && !garraOcupada &&
                    modoOperacion == MODO_AUTO)
                {
                    garraOcupada = true;
                    evento.sensor = sens[i].id;
                    evento.generacion = generacionParada;
                    evento.origen = ORIGEN_AUTO;
                    ultimoEvento = (sens[i].id == 2) ? EV_SENSOR2 : EV_SENSOR3;
                    reservado = true;
                }
                portEXIT_CRITICAL(&mux);

                if (reservado)
                {
                    // Un objeto ya atendido no puede reactivar ningún sensor
                    // hasta que ambos queden libres.
                    sens[0].armado = false;
                    sens[1].armado = false;

                    xQueueSend(colaGarra, &evento, 0);
                    xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);   // detener la banda ya
                    break;
                }
            }
        }
    }
}


// =====================================================
// TAREA BANDA (única que ordena girar/detener al motor)
// =====================================================

void tareaBandaFn(void *parametro)
{
    for (;;)
    {
        uint32_t bits;

        // Reacciona al instante a una notificación o revisa cada 20 ms
        xTaskNotifyWait(0, TODOS_LOS_BITS, &bits, pdMS_TO_TICKS(20));

        // Decisión y escritura juntas, bajo el mismo bloqueo que usa STOP:
        // así esta tarea nunca puede reactivar la banda después de un STOP.
        portENTER_CRITICAL(&mux);

        // AUTO: condición original.
        bool permitido = sistemaActivo && !emergenciaActiva && !garraOcupada;

        // En MANUAL además hace falta la solicitud manual.
        if (modoOperacion == MODO_MANUAL)
        {
            permitido = permitido && manualBandaSolicitada;
        }

        bandaGirando = permitido;
        portEXIT_CRITICAL(&mux);
    }
}


// =========================================
// TAREA GARRA (única que mueve los servos)
// =========================================

void tareaGarraFn(void *parametro)
{
    for (;;)
    {
        EventoGarra evento;
        uint32_t bits;

        if (xQueueReceive(colaGarra, &evento, pdMS_TO_TICKS(100)) != pdTRUE)
        {
            continue;
        }

        // Descartar un aviso anterior que siga pendiente
        xTaskNotifyWait(0, TODOS_LOS_BITS, &bits, 0);

        // ---------- Solicitud de volver al reposo (GARRA;HOME) ----------
        if (evento.origen == ORIGEN_HOME)
        {
            bool validoHome;
            portENTER_CRITICAL(&mux);
            validoHome = !emergenciaActiva &&
                         (modoOperacion == MODO_MANUAL) &&
                         (evento.generacion == generacionParada);
            portEXIT_CRITICAL(&mux);

            if (validoHome)
            {
                garraDesactivar();
            }

            portENTER_CRITICAL(&mux);
            garraOcupada = false;
            portEXIT_CRITICAL(&mux);

            xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
            continue;
        }

        // Validar el evento: sistema activo y sin STOP desde que se creó.
        // El modo actual debe coincidir con el origen del evento.
        bool valido;
        portENTER_CRITICAL(&mux);
        valido = sistemaActivo && !emergenciaActiva &&
                 (evento.generacion == generacionParada) &&
                 ((evento.origen == ORIGEN_MANUAL) ? (modoOperacion == MODO_MANUAL)
                                                   : (modoOperacion == MODO_AUTO));
        portEXIT_CRITICAL(&mux);

        if (valido)
        {
            // Movimiento de almacenamiento correspondiente al sensor
            garraActivar(evento.sensor);

            // Mantiene la posición TIEMPO_GARRA ms. Si llega STOP,
            // la espera termina inmediatamente.
            xTaskNotifyWait(0, TODOS_LOS_BITS, &bits, pdMS_TO_TICKS(TIEMPO_GARRA));

            // Se comprueba si hubo STOP durante el movimiento
            bool huboStop;
            portENTER_CRITICAL(&mux);
            huboStop = emergenciaActiva || (evento.generacion != generacionParada);
            portEXIT_CRITICAL(&mux);

            if (huboStop)
            {
                // PARADA DE EMERGENCIA. Los servos NO se mueven:
                // quedan exactamente en su posición actual. La garra sigue
                // reservada (garraOcupada = true) y la banda sigue detenida.
                // Se espera, sin bloquear indefinidamente, a que una persona
                // presione START.
                garraPausada = true;   // Para la telemetría (GARRA=PAUSADA)

                for (;;)
                {
                    bool reanudado;
                    portENTER_CRITICAL(&mux);
                    reanudado = sistemaActivo && !emergenciaActiva;
                    portEXIT_CRITICAL(&mux);

                    if (reanudado)
                    {
                        break;
                    }

                    xTaskNotifyWait(0, TODOS_LOS_BITS, &bits, pdMS_TO_TICKS(100));
                }

                garraPausada = false;
            }

            // Fin normal, o START tras la emergencia: la garra vuelve al
            // ángulo inicial (en el caso de emergencia, solo después de START).
            garraDesactivar();
        }

        // Libera la garra y avisa a la banda
        portENTER_CRITICAL(&mux);
        garraOcupada = false;
        portEXIT_CRITICAL(&mux);

        xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
    }
}


// =====================================================
// ===== INICIO DEL BLOQUE BLUETOOTH (solo si USAR_BLUETOOTH = 1) =====
// =====================================================
#if USAR_BLUETOOTH

// START desde la app: misma lógica que el pulsador, pero rechazada si
// el pulsador físico STOP sigue presionado. La lectura del pin se hace
// dentro de la sección crítica para no pisar un STOP físico simultáneo.
static void comandoStart()
{
    bool aceptado = false;
    bool veniaDeEmergencia = false;

    portENTER_CRITICAL(&mux);
    if (gpio_get_level((gpio_num_t)STOP) == 1)   // STOP liberado (INPUT_PULLUP)
    {
        veniaDeEmergencia = emergenciaActiva;
        emergenciaActiva = false;
        sistemaActivo    = true;
        manualBandaSolicitada = false;
        ultimoEvento = EV_START_BT;
        aceptado = true;
    }
    else
    {
        ultimoEvento = EV_RECH_STOP_FISICO;
    }
    portEXIT_CRITICAL(&mux);

    if (aceptado)
    {
        if (veniaDeEmergencia)
        {
            xTaskNotify(tareaGarra, NOTIF_REANUDAR, eSetBits);
        }
        xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
    }
}

// STOP desde la app: misma lógica de emergencia, pero con funciones de TAREA
// (no se llama a la ISR ni a funciones FromISR).
static void comandoStop()
{
    portENTER_CRITICAL(&mux);
    emergenciaActiva = true;
    sistemaActivo    = false;
    bandaGirando     = false;
    manualBandaSolicitada = false;
    generacionParada++;
    ultimoEvento = EV_STOP_BT;
    portEXIT_CRITICAL(&mux);

    gpio_set_level((gpio_num_t)BANDA_STEP, 0);

    // tareaControl (prioridad máxima) interrumpe la espera de la garra
    // sin mover servos y avisa a la banda.
    xTaskNotify(tareaControl, NOTIF_STOP, eSetBits);
}

// Cambio de modo: solo sin emergencia y con la garra libre.
// Detiene el sistema y exige un nuevo START.
static void comandoModo(ModoOperacion nuevo)
{
    bool aceptado = false;

    portENTER_CRITICAL(&mux);
    if (emergenciaActiva)
    {
        ultimoEvento = EV_RECH_EMERGENCIA;
    }
    else if (garraOcupada)
    {
        ultimoEvento = EV_RECH_OCUPADA;
    }
    else if (modoOperacion == nuevo)
    {
        // Ya está en ese modo: no se detiene nada.
        ultimoEvento = (nuevo == MODO_AUTO) ? EV_MODO_AUTO : EV_MODO_MANUAL;
    }
    else
    {
        sistemaActivo = false;               // exige un nuevo START
        manualBandaSolicitada = false;
        modoOperacion = nuevo;
        ultimoEvento = (nuevo == MODO_AUTO) ? EV_MODO_AUTO : EV_MODO_MANUAL;
        aceptado = true;
    }
    portEXIT_CRITICAL(&mux);

    if (aceptado)
    {
        xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
    }
}

// Banda manual: solo modifica la solicitud; tareaBandaFn decide bandaGirando.
static void comandoBanda(bool encender)
{
    portENTER_CRITICAL(&mux);
    if (!encender)
    {
        manualBandaSolicitada = false;       // apagar siempre es seguro
        ultimoEvento = EV_BANDA_OFF;
    }
    else if (modoOperacion != MODO_MANUAL)
    {
        ultimoEvento = EV_RECH_MODO;
    }
    else if (emergenciaActiva)
    {
        ultimoEvento = EV_RECH_EMERGENCIA;
    }
    else if (!sistemaActivo)
    {
        ultimoEvento = EV_RECH_NO_ACTIVO;
    }
    else if (garraOcupada)
    {
        ultimoEvento = EV_RECH_OCUPADA;
    }
    else
    {
        manualBandaSolicitada = true;
        ultimoEvento = EV_BANDA_ON;
    }
    portEXIT_CRITICAL(&mux);

    xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
}

// Garra manual: sensor 2 o 3 (clasificación) o 0 (HOME).
// Nunca mueve servos: reserva la garra y envía un evento a colaGarra.
static void comandoGarra(uint8_t sensor)
{
    EventoGarra evento;
    bool reservado = false;

    portENTER_CRITICAL(&mux);
    if (modoOperacion != MODO_MANUAL)
    {
        ultimoEvento = EV_RECH_MODO;
    }
    else if (emergenciaActiva)
    {
        ultimoEvento = EV_RECH_EMERGENCIA;
    }
    else if (sensor != 0 && !sistemaActivo)      // HOME no exige sistema iniciado
    {
        ultimoEvento = EV_RECH_NO_ACTIVO;
    }
    else if (garraOcupada)
    {
        ultimoEvento = EV_RECH_OCUPADA;
    }
    else
    {
        garraOcupada = true;                      // reserva atómica
        evento.sensor = sensor;
        evento.generacion = generacionParada;
        evento.origen = (sensor == 0) ? ORIGEN_HOME : ORIGEN_MANUAL;
        ultimoEvento = (sensor == 2) ? EV_MANUAL_S2
                     : (sensor == 3) ? EV_MANUAL_S3
                                     : EV_HOME;
        reservado = true;
    }
    portEXIT_CRITICAL(&mux);

    if (reservado)
    {
        if (xQueueSend(colaGarra, &evento, 0) != pdTRUE)
        {
            // Cola llena: se libera la reserva para no bloquear la garra.
            portENTER_CRITICAL(&mux);
            garraOcupada = false;
            ultimoEvento = EV_RECH_COLA;
            portEXIT_CRITICAL(&mux);
        }

        xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);   // detener la banda / actualizar
    }
}

// Interpreta una línea completa (sin \n). Solo comandos exactos.
static void procesarComando(const char *cmd)
{
    if      (strcmp(cmd, "START")       == 0) comandoStart();
    else if (strcmp(cmd, "STOP")        == 0) comandoStop();
    else if (strcmp(cmd, "MODE;AUTO")   == 0) comandoModo(MODO_AUTO);
    else if (strcmp(cmd, "MODE;MANUAL") == 0) comandoModo(MODO_MANUAL);
    else if (strcmp(cmd, "BANDA;ON")    == 0) comandoBanda(true);
    else if (strcmp(cmd, "BANDA;OFF")   == 0) comandoBanda(false);
    else if (strcmp(cmd, "GARRA;S2")    == 0) comandoGarra(2);
    else if (strcmp(cmd, "GARRA;S3")    == 0) comandoGarra(3);
    else if (strcmp(cmd, "GARRA;HOME")  == 0) comandoGarra(0);
    else
    {
        portENTER_CRITICAL(&mux);
        ultimoEvento = EV_CMD_DESCONOCIDO;
        portEXIT_CRITICAL(&mux);
    }
}

// Toma una copia coherente del estado y envía exactamente 11 campos:
// ESTADO;AUTO;ACTIVO;BANDA=1;DIST=18.5;PRES=1;S2=0;S3=1;HAB=1;GARRA=REPOSO;EV=NINGUNO\n
static void enviarTelemetria()
{
    Telemetria t;
    bool sis, emer, banda, ocupada, pausada;
    ModoOperacion modo;
    uint8_t ev;

    portENTER_CRITICAL(&mux);
    t       = tel;
    sis     = sistemaActivo;
    emer    = emergenciaActiva;
    banda   = bandaGirando;
    ocupada = garraOcupada;
    pausada = garraPausada;
    modo    = modoOperacion;
    ev      = ultimoEvento;
    portEXIT_CRITICAL(&mux);

    if (ev >= EV_TOTAL) ev = EV_NINGUNO;

    const char *txtModo   = (modo == MODO_MANUAL) ? "MANUAL" : "AUTO";
    const char *txtSis    = emer ? "EMERGENCIA" : (sis ? "ACTIVO" : "DETENIDO");
    const char *txtGarra  = pausada ? "PAUSADA" : (ocupada ? "OCUPADA" : "REPOSO");

    char dist[12];
    if (t.distanciaCm > 0.0f) snprintf(dist, sizeof(dist), "%.1f", t.distanciaCm);
    else                      snprintf(dist, sizeof(dist), "-1");

    char msg[200];
    int n = snprintf(msg, sizeof(msg),
                     "ESTADO;%s;%s;BANDA=%d;DIST=%s;PRES=%d;S2=%d;S3=%d;HAB=%d;GARRA=%s;EV=%s\n",
                     txtModo, txtSis,
                     banda ? 1 : 0,
                     dist,
                     (int)t.presencia,
                     t.s2 ? 1 : 0,
                     t.s3 ? 1 : 0,
                     t.habilitado ? 1 : 0,
                     txtGarra,
                     NOMBRES_EVENTO[ev]);

    if (n > 0 && n < (int)sizeof(msg))
    {
        SerialBT.write((const uint8_t *)msg, (size_t)n);
    }
}

// TAREA BLUETOOTH (prioridad baja)
void tareaBluetoothFn(void *parametro)
{
    char   linea[TAM_LINEA_BT];
    size_t idx = 0;
    bool   descartando = false;      // línea demasiado larga: se descarta completa
    bool   conectadoPrev = false;

    TickType_t ultimoEnvio = xTaskGetTickCount();

    for (;;)
    {
        vTaskDelay(pdMS_TO_TICKS(PERIODO_TAREA_BT_MS));

        bool conectado = SerialBT.hasClient();

        // ---------- Sin conexión ----------
        if (!conectado)
        {
            if (conectadoPrev)
            {
                // Desconexión: se retira la solicitud manual de la banda.
                // En AUTO la clasificación sigue funcionando normalmente.
                portENTER_CRITICAL(&mux);
                manualBandaSolicitada = false;
                ultimoEvento = EV_BT_DESCONECTADO;
                portEXIT_CRITICAL(&mux);

                xTaskNotify(tareaBanda, NOTIF_ACTUALIZAR, eSetBits);
            }

            // Se descarta todo lo pendiente: nada antiguo se ejecuta al reconectar.
            idx = 0;
            descartando = false;
            while (SerialBT.available())
            {
                SerialBT.read();
            }

            conectadoPrev = false;
            continue;
        }

        // ---------- Conexión nueva ----------
        if (!conectadoPrev)
        {
            conectadoPrev = true;
            idx = 0;
            descartando = false;
            // Fuerza un envío inmediato de estado
            ultimoEnvio = xTaskGetTickCount() - pdMS_TO_TICKS(PERIODO_TELEMETRIA_MS);
        }

        // ---------- Recepción de comandos (sin bloquear) ----------
        int leidos = 0;
        while (SerialBT.available() && leidos < MAX_BYTES_POR_CICLO)
        {
            int c = SerialBT.read();
            leidos++;

            if (c < 0)
            {
                break;
            }

            if (c == '\r')
            {
                continue;                       // se ignora
            }

            if (c == '\n')
            {
                if (!descartando && idx > 0)
                {
                    linea[idx] = '\0';
                    procesarComando(linea);     // solo líneas completas
                }
                idx = 0;
                descartando = false;
                continue;
            }

            if (descartando)
            {
                continue;
            }

            if (idx < (TAM_LINEA_BT - 1))
            {
                linea[idx++] = (char)c;
            }
            else
            {
                // Línea demasiado larga: se descarta hasta el próximo '\n'.
                descartando = true;
                idx = 0;
            }
        }

        // ---------- Telemetría periódica ----------
        if ((TickType_t)(xTaskGetTickCount() - ultimoEnvio) >= pdMS_TO_TICKS(PERIODO_TELEMETRIA_MS))
        {
            ultimoEnvio = xTaskGetTickCount();
            enviarTelemetria();
        }
    }
}

